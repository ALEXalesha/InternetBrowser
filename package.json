{
  "name": "internet-browser",
  "productName": "InternetBrowser",
  "version": "0.1.0",
  "description": "InternetBrowser: a good-looking Electron browser without ads and tracking - tabs, address bar with search, bookmarks, history, downloads, Chrome import; everything stays local",
  "author": "ALEXalesha",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "homepage": "https://github.com/ALEXalesha/InternetBrowser",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "cover": "c8 --check-coverage node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "cover:core": "c8 --config .c8rc.core.json --check-coverage node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "test:app": "playwright test --config=playwright.app.config.js --workers=1",
    "mutate": "node tools/mutate.js",
    "lists": "node tools/fetch-lists.js",
    "screens": "node tools/screenshots.js",
    "icon": "node tools/make-icon.js",
    "dist": "node tools/fetch-lists.js && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "c8": "12.0.0",
    "electron": "44.10.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.alexalesha.internetbrowser",
    "productName": "InternetBrowser",
    "copyright": "Copyright (c) 2026 ALEXalesha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "LICENSE",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "filters",
        "to": "filters",
        "filter": [
          "*.txt"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "compression": "maximum",
    "publish": null,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InternetBrowser",
      "artifactName": "InternetBrowser-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "InternetBrowser-${version}-Portable.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
